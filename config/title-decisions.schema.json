{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "title", "reason"],
        "properties": {
          "id": { "type": "string" },
          "action": { "type": "string", "enum": ["keep", "rename"] },
          "title": { "type": ["string", "null"] },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
